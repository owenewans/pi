{
  "name": "@owenewans/pi-code-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "postinstall": "node apply-patches.mjs",
    "test": "node --test test/*.test.mjs",
    "setup": "node apply-patches.mjs && python3 install-tools.py",
    "test:live": "node test/live.mjs c && node test/live.mjs go && node test/live.mjs rust && node test/live.mjs javascript && node test/live.mjs typescript && node test/live.mjs python && node test/child.mjs"
  },
  "dependencies": {
    "@ast-grep/cli": "0.51.0",
    "@ff-labs/pi-fff": "0.11.0",
    "@gotgenes/pi-autoformat": "5.1.11",
    "@ian-pascoe/pi-lsp": "0.15.4",
    "pi-fovea": "0.33.2",
    "prettier": "3.9.10",
    "pyright": "1.1.414",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@ast-grep/cli": "0.51.0",
    "@ian-pascoe/pi-utils": "0.12.0",
    "vscode-languageserver-protocol": "3.18.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
